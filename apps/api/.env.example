# Copie para .env e preencha localmente, sem aspas e sem export.
GOOGLE_MAPS_API_KEY=
# Conexão da aplicação: use um login com as permissões de maonaroda_api.
# Preencha a URL antes de iniciar. Exemplo local: jdbc:postgresql://localhost:5432/maonaroda
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Migrations usam FLYWAY_URL, FLYWAY_USER e FLYWAY_PASSWORD no ambiente do terminal.
# O plugin Flyway não importa este arquivo.

# Somente ao usar o perfil Supabase (leia database/INTEGRACAO.md):
# SPRING_PROFILES_ACTIVE=supabase
# Certificado raiz versionado em apps/api/certs/ (use o caminho absoluto do seu clone).
# SUPABASE_DB_CA_CERT=C:/git/mao-na-roda/apps/api/certs/supabase-prod-ca-2021.crt

# Validação do JWT do Supabase Auth:
# AUTH_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
# AUTH_JWK_SET_URI=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_AUDIENCE=authenticated
