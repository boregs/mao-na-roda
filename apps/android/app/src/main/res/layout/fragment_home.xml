<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_map_surface">
    <FrameLayout
        android:id="@+id/map_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_home_status"
            android:elevation="2dp"
            android:padding="20dp">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_brand_mark"
                android:contentDescription="@null"
                android:padding="16dp"
                android:src="@drawable/ic_map"
                app:tint="@color/on_ocean" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Seu mapa de acessibilidade começa aqui"
                android:textAppearance="@style/MaoText.Section"
                android:textColor="@color/ink" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="A integração com mapas ainda está sendo preparada. Nenhuma rota ou condição de rua é exibida sem dados reais."
                android:textAppearance="@style/MaoText.Meta"
                android:textColor="@color/supporting" />
            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:checkable="false"
                android:clickable="false"
                android:text="Mapa em preparação"
                android:textColor="@color/supporting"
                app:chipBackgroundColor="@color/card"
                app:chipIcon="@drawable/ic_info"
                app:chipIconTint="@color/ocean"
                app:ensureMinTouchTargetSize="true" />
        </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/search"
                style="@style/Widget.MaoButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="@color/home_floating_surface"
                android:gravity="start|center_vertical"
                android:text="Origem e destino"
                android:textColor="@color/supporting"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart"
                app:iconTint="@color/ocean" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/account"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Conta. Autenticação ainda indisponível."
                app:icon="@drawable/ic_account"
                app:iconTint="@color/on_ocean"
                app:backgroundTint="@color/ocean" />
        </LinearLayout>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/map_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="true"
        android:background="@drawable/bg_home_sheet"
        android:elevation="10dp"
        android:clipToPadding="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        app:behavior_peekHeight="148dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">
            <FrameLayout
                android:id="@+id/panel_toggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Expandir painel de ações"
                android:foreground="?attr/selectableItemBackground"
                android:importantForAccessibility="yes">
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sheet_handle" />
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Planeje um caminho possível"
                android:textAppearance="@style/MaoText.Section"
                android:textColor="@color/ink" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Acessibilidade vem antes da distância."
                android:textAppearance="@style/MaoText.Meta"
                android:textColor="@color/supporting" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile"
                style="@style/Widget.MaoButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="start|center_vertical"
                android:text="Perfil de mobilidade"
                app:icon="@drawable/ic_material_accessible_forward"
                app:iconGravity="textStart" />
            <TextView
                android:id="@+id/profile_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/MaoText.Meta"
                android:textColor="@color/supporting" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/report_barrier"
                style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:text="Relatar uma barreira"
                app:icon="@drawable/ic_info"
                app:iconGravity="textStart" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:drawableStart="@drawable/ic_material_history"
                android:drawablePadding="12dp"
                android:drawableTint="@color/ocean"
                android:text="Locais recentes"
                android:textAppearance="@style/MaoText.Card"
                android:textColor="@color/ink" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Os destinos recentes aparecerão aqui quando a busca estiver disponível."
                android:textAppearance="@style/MaoText.Meta"
                android:textColor="@color/supporting" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/report_history"
                style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="start|center_vertical"
                android:text="Meus relatos"
                app:icon="@drawable/ic_material_history"
                app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/about"
                style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="start|center_vertical"
                android:text="Como funciona"
                app:icon="@drawable/ic_material_info"
                app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
