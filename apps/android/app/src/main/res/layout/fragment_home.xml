<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/home_map_surface">
    <FrameLayout android:id="@+id/map_surface" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:id="@+id/map_container" android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:id="@+id/map_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:padding="24dp" android:gravity="center"
            android:text="@string/map_not_configured" android:textAppearance="@style/MaoText.Body" />
    </FrameLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/map_panel"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp"
        android:background="@drawable/bg_home_sheet" android:elevation="10dp" android:fillViewport="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false" app:behavior_peekHeight="200dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="20dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/panel_toggle" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/expand_planning" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/plan_title" android:textAppearance="@style/MaoText.Section" android:accessibilityHeading="true" />
            <TextView android:id="@+id/planning_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/MaoText.Meta" android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/planning_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/origin" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/origin_input"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:inputType="textPostalAddress" android:saveEnabled="false" android:importantForAutofill="no" android:maxLength="200" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/search_origin" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/find_origin" />
            <com.google.android.material.button.MaterialButton android:id="@+id/use_location" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/use_location" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/destination">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/destination_input"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:inputType="textPostalAddress" android:saveEnabled="false" android:importantForAutofill="no" android:maxLength="200" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/search_destination" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/find_destination" />
            <LinearLayout android:id="@+id/destination_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/manual_coordinates_help" android:textAppearance="@style/MaoText.Meta" />
            <com.google.android.material.button.MaterialButton android:id="@+id/profile" style="@style/Widget.MaoButton.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/select_route_profile" />
            <TextView android:id="@+id/profile_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MaoText.Meta" />
            <com.google.android.material.button.MaterialButton android:id="@+id/search" style="@style/Widget.MaoButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/consult_route" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cancel_query" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cancel_query" />
            <LinearLayout android:id="@+id/route_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/interface_preferences" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/interface_preferences" />
            <com.google.android.material.button.MaterialButton android:id="@+id/account" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_title" />
            <com.google.android.material.button.MaterialButton android:id="@+id/report_barrier" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/local_report" />
            <com.google.android.material.button.MaterialButton android:id="@+id/report_history" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/local_report_history" />
            <com.google.android.material.button.MaterialButton android:id="@+id/about" style="@style/Widget.MaoButton.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/how_it_works" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
