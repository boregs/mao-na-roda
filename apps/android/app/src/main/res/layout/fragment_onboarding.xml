<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paper">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="600dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_brand_mark"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_alt_route"
                app:tint="@color/on_ocean" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textAppearance="@style/MaoText.Body"
                android:textStyle="normal" />
        </LinearLayout>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:text="@string/onboarding_title"
            style="@style/MaoText.Welcome" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboarding_body"
            android:textAppearance="@style/MaoText.Body"
            android:textColor="@color/supporting"
            android:textStyle="normal" />
        <Space
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            style="@style/Widget.MaoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continue_guest" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/createButton"
            style="@style/Widget.MaoButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/create_account" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signInButton"
            style="@style/Widget.MaoButton.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sign_in_link" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/howButton"
            style="@style/Widget.MaoButton.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/how_it_works"
            app:icon="@drawable/ic_material_info"
            app:iconGravity="textStart" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/version_dev"
            android:textAppearance="@style/MaoText.Footer"
            android:textStyle="normal" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
