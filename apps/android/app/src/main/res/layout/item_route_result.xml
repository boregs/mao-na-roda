<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MaoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/home_floating_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/route_card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/route_recommended"
            android:textAppearance="@style/MaoText.Footer"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/route_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/MaoText.Card" />

        <TextView
            android:id="@+id/route_card_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/MaoText.Meta" />

        <TextView
            android:id="@+id/route_card_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/MaoText.Footer" />

        <LinearLayout
            android:id="@+id/route_card_alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/route_card_details"
            style="@style/Widget.MaoButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/route_open_details" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
