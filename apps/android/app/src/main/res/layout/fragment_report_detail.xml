<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/paper" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/detail_back"
            style="@style/Widget.MaoButton.Text" android:layout_width="wrap_content"
            android:layout_height="56dp" android:text="Voltar" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Detalhes do relato"
            android:textAppearance="@style/MaoText.Heading" android:textColor="@color/ink" />
        <TextView android:id="@+id/detail_category" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:textAppearance="@style/MaoText.Card" android:textColor="@color/ink" />
        <TextView android:id="@+id/detail_date" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textAppearance="@style/MaoText.Meta" android:textColor="@color/supporting" />
        <TextView android:id="@+id/detail_description" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:textAppearance="@style/MaoText.Body" android:textColor="@color/ink" />
        <ImageView android:id="@+id/detail_photo" android:layout_width="match_parent"
            android:layout_height="240dp" android:layout_marginTop="20dp"
            android:contentDescription="Foto anexada ao relato" android:scaleType="centerCrop" />
    </LinearLayout>
</ScrollView>
