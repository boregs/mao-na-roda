<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startupFragment">
    <fragment
        android:id="@+id/startupFragment"
        android:name="com.maonaroda.mao_na_roda.StartupFragment">
        <action
            android:id="@+id/action_startup_to_onboarding"
            app:destination="@id/onboardingFragment" />
        <action
            android:id="@+id/action_startup_to_home"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.maonaroda.mao_na_roda.OnboardingFragment">
        <action
            android:id="@+id/action_onboarding_to_auth"
            app:destination="@id/authFragment" />
        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/authFragment"
        android:name="com.maonaroda.mao_na_roda.AuthFragment">
        <argument
            android:name="signIn"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.maonaroda.mao_na_roda.HomeFragment">
        <action
            android:id="@+id/action_home_to_accessibility_profile"
            app:destination="@id/accessibilityProfileFragment" />
        <action
            android:id="@+id/action_home_to_report_form"
            app:destination="@id/reportFormFragment" />
        <action
            android:id="@+id/action_home_to_report_history"
            app:destination="@id/reportHistoryFragment" />
    </fragment>
    <fragment
        android:id="@+id/accessibilityProfileFragment"
        android:name="com.maonaroda.mao_na_roda.AccessibilityProfileFragment" />
    <fragment
        android:id="@+id/reportFormFragment"
        android:name="com.maonaroda.mao_na_roda.ReportFormFragment">
        <action
            android:id="@+id/action_form_to_history"
            app:destination="@id/reportHistoryFragment"
            app:popUpTo="@id/reportFormFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/reportHistoryFragment"
        android:name="com.maonaroda.mao_na_roda.ReportHistoryFragment">
        <action
            android:id="@+id/action_history_to_report_detail"
            app:destination="@id/reportDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/reportDetailFragment"
        android:name="com.maonaroda.mao_na_roda.ReportDetailFragment">
        <argument android:name="reportId" app:argType="string" />
    </fragment>
</navigation>
