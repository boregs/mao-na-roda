<?xml version="1.0" encoding="utf-8"?>
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Static instances of the bundled variable font also support Android 7. -->
    <font
        android:font="@font/source_sans_3_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/source_sans_3_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/source_sans_3_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/source_sans_3_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
